diff -ruN a/component/dialer/usehook.go b/component/dialer/usehook.go
--- a/component/dialer/usehook.go
+++ b/component/dialer/usehook.go
@@ -0,0 +1,47 @@
+package dialer
+
+// CUSTOM (CUSTOM.md #7, not part of upstream): tells the app which address of a node a request really
+// goes through. The xhttp client calls NoteUse for every request (a new connection and a reused one
+// alike, from the GotConn trace); the app listens through SetUseHook.
+//
+// Nothing runs on its own: NoteUse is called when a request is made anyway, and does one atomic
+// load when nobody listens.
+
+import (
+	"net"
+	"net/netip"
+	"sync/atomic"
+)
+
+var useHook atomic.Pointer[func(owner, ip string)]
+
+// SetUseHook sets the listener; nil removes it.
+func SetUseHook(f func(owner, ip string)) {
+	if f == nil {
+		useHook.Store(nil)
+
+		return
+	}
+
+	useHook.Store(&f)
+}
+
+// NoteUse reports that a request of the node `owner` goes through the peer address `addr`.
+func NoteUse(owner string, addr net.Addr) {
+	p := useHook.Load()
+	if p == nil || addr == nil {
+		return
+	}
+
+	host, _, err := net.SplitHostPort(addr.String())
+	if err != nil {
+		return
+	}
+
+	a, err := netip.ParseAddr(host)
+	if err != nil {
+		return
+	}
+
+	(*p)(owner, a.Unmap().String())
+}

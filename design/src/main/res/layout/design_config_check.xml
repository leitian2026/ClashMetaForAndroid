<?xml version="1.0" encoding="utf-8"?>
<!-- CUSTOM (CUSTOM.md #22): config check page -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.custom.ConfigCheckDesign" />
        <import type="com.github.kr328.clash.design.custom.ConfigCheckDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.github.kr328.clash.design.view.ActivityBarLayout
                android:id="@+id/activity_bar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@{self.surface.insets.top}">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/item_tailing_margin">

                    <include
                        layout="@layout/common_activity_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/check_hint_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/check_hint_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/check_copy_view"
                        android:text="@string/check_hint_button" />

                    <ImageView
                        android:id="@+id/check_copy_view"
                        android:layout_width="@dimen/item_tailing_component_size"
                        android:layout_height="@dimen/item_tailing_component_size"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/item_tailing_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/errors_copy"
                        android:focusable="true"
                        android:onClick="@{() -> self.request(Request.Copy)}"
                        android:padding="@dimen/toolbar_image_action_padding"
                        android:src="@drawable/ic_baseline_content_copy" />
                </RelativeLayout>
            </com.github.kr328.clash.design.view.ActivityBarLayout>

            <!-- CUSTOM (CUSTOM.md #90): outlined domain field; preserve the row's existing horizontal padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/item_tailing_margin">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <!-- CUSTOM (CUSTOM.md #26 #91): history/drop-down behavior stays on the input itself -->
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        style="@style/Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox"
                        android:id="@+id/check_domain_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:hint="@string/check_domain_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- CUSTOM (CUSTOM.md #89): utility actions row, equal widths -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/item_tailing_margin">

                <!-- CUSTOM (CUSTOM.md #30): view the effective config -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/check_effective_view"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> self.request(Request.Effective)}"
                    android:text="@string/eff_start" />

                <!-- CUSTOM (CUSTOM.md #26 #89): clear DNS or fake-IP cache, error color like the connections page -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/check_flush_view"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> self.request(Request.Flush)}"
                    android:text="@string/check_flush_start"
                    android:textColor="?attr/colorError" />

                <!-- CUSTOM (CUSTOM.md #94): an empty third column, so these two sit in the same columns as the three tests below -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- CUSTOM (CUSTOM.md #89): the three tests, equal widths, right above the table -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/item_tailing_margin">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/check_toggle_view"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> self.request(Request.Toggle)}"
                    android:text="@string/check_start" />

                <!-- CUSTOM (CUSTOM.md #25 #26): DNS check uses the same domain field -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/check_dns_view"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> self.request(Request.Dns)}"
                    android:text="@string/check_dns_start" />

                <!-- CUSTOM (CUSTOM.md #43): test other IPs (not the ones in the config) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/check_ip_view"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> self.request(Request.IpTest)}"
                    android:text="@string/iptest_button" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorControlHighlight" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@{self.surface.insets.bottom}">

                <!-- CUSTOM (CUSTOM.md #52): the IP test table sits under the text view (which is empty then) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/check_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/item_tailing_margin"
                        android:paddingVertical="@dimen/item_padding_vertical"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textIsSelectable="true" />

                    <FrameLayout
                        android:id="@+id/check_ip_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/item_tailing_margin"
                        android:paddingVertical="@dimen/item_padding_vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
